# ============================================
# Global .gitignore for MERN practice folders
# Applies to every project under this directory
# ============================================

# ---------- Dependencies ----------
node_modules/
bower_components/
jspm_packages/
.pnp
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# ---------- Build output / bundles ----------
dist/
dist-ssr/
build/
out/
.next/
.nuxt/
.cache/
.parcel-cache/
.vite/
*.tsbuildinfo

# ---------- Environment & secrets ----------
.env
.env.*
!.env.example
!.env.sample
*.pem
*.key
*.crt
secrets.json

# ---------- Logs ----------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# ---------- Runtime data / uploads (MongoDB, file uploads) ----------
pids/
*.pid
*.seed
*.pid.lock
data/
uploads/
tmp/
temp/

# ---------- Testing & coverage ----------
coverage/
.nyc_output/
*.lcov

# ---------- Local config overrides ----------
*.local
.eslintcache
.stylelintcache

# ---------- Editors & IDEs ----------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*~

# ---------- OS files ----------
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ---------- Misc ----------
.npm/
.yarn-integrity
*.tgz
.temp/
