      "isDeleted": false,
      "boundElements": [],
      "updated": 1795162935509,
      "link": null,
      "locked": false,
      "text": "src/asyncHandler.js is supposed to forward async errors to the\nglobal error middleware. Read it carefully:\n\na) What is wrong with this wrapper? What does `next` refer to?\nb) If a controller throws AppError('x', 400), what happens to the\n    request? Does the client get a response?\nc) Fix the wrapper so the error reaches errorMiddleware.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "src/asyncHandler.js is supposed to forward async errors to the\nglobal error middleware. Read it carefully:\n\na) What is wrong with this wrapper? What does `next` refer to?\nb) If a controller throws AppError('x', 400), what happens to the\n    request? Does the client get a response?\nc) Fix the wrapper so the error reaches errorMiddleware.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "aA"
    },
