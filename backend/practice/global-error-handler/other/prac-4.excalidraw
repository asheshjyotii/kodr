      "id": "e7",
      "type": "text",
      "x": 860,
      "y": 175,
      "width": 662.4,
      "height": 280,
      "text": "app.get('/a', (req, res, next) => next())\napp.get('/a', (req, res) => res.send('second /a'))\n\napp.get('/b', (req, res, next) => next(new AppError('nope', 403)))\napp.get('/b', (req, res) => res.send('second /b'))\n\napp.get('/c', (req, res, next) => next('route'))\napp.get('/c', (req, res) => res.send('second /c'))\n\napp.get('/d', (req, res) => { return new AppError('lost', 400) })\n\napp.use((req, res) => res.status(404).json({ message: 'not found' }))\napp.use((err, req, res, next) =>\n  res.status(err.statusCode || 500).json({ message: err.message }))",
      "originalText": "app.get('/a', (req, res, next) => next())\napp.get('/a', (req, res) => res.send('second /a'))\n\napp.get('/b', (req, res, next) => next(new AppError('nope', 403)))\napp.get('/b', (req, res) => res.send('second /b'))\n\napp.get('/c', (req, res, next) => next('route'))\napp.get('/c', (req, res) => res.send('second /c'))\n\napp.get('/d', (req, res) => { return new AppError('lost', 400) })\n\napp.use((req, res) => res.status(404).json({ message: 'not found' }))\napp.use((err, req, res, next) =>\n  res.status(err.statusCode || 500).json({ message: err.message }))",
