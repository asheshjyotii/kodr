      "width": 528,
      "height": 180,
      "text": "app.use('/api/auth', authRouter)\napp.use(notFound)\napp.use(logError)\napp.use(translateError)\napp.use(sendError)\n\n// shape of a Mongoose ValidationError:\n// err.name === 'ValidationError'\n// err.errors = { email: { message: 'required' }, ... }",
