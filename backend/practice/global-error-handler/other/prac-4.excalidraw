      "id": "e19",
      "type": "text",
      "x": 860,
      "y": 1132.5,
      "width": 528,
      "height": 200,
      "text": "app.get('/config', (req, res, next) => {\n  fs.readFile('./config.json', 'utf8', (err, data) => {\n    if (err) {\n      next(new AppError('Config missing', 404))\n    }\n    const parsed = JSON.parse(data)\n    res.json(parsed)\n  })\n  res.status(202)\n})",
      "originalText": "app.get('/config', (req, res, next) => {\n  fs.readFile('./config.json', 'utf8', (err, data) => {\n    if (err) {\n      next(new AppError('Config missing', 404))\n    }\n    const parsed = JSON.parse(data)\n    res.json(parsed)\n  })\n  res.status(202)\n})",
