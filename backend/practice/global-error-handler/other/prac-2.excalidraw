      "text": "Q3. Which errors reach the global handler?",
      "originalText": "Q3. Which errors reach the global handler?",
      "fontSize": 22,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
