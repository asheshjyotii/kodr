      "boundElements": [],
      "updated": 1795163114423,
      "link": null,
      "locked": false,
      "text": "Express 4 does not catch errors from every place. Look at this code:\n\na) Which of the three throws below reach errorMiddleware?\nb) Which ones crash the process, and what handler would you add\n    in server.js to log them and shut down cleanly?",
      "originalText": "Express 4 does not catch errors from every place. Look at this code:\n\na) Which of the three throws below reach errorMiddleware?\nb) Which ones crash the process, and what handler would you add\n    in server.js to log them and shut down cleanly?",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "p18",
      "type": "text",
      "x": 70,
      "y": 1226,
      "width": 720,
      "height": 140.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
