      "versionNonce": 699987604,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795163114423,
      "link": null,
      "locked": false,
      "text": "app.get('/a', (req, res) => { throw new Error('A') })\n\napp.get('/b', async (req, res) => { throw new Error('B') })\n\napp.get('/c', (req, res) => {\n  setTimeout(() => { throw new Error('C') }, 100)\n  res.send('ok')\n})",
      "originalText": "app.get('/a', (req, res) => { throw new Error('A') })\n\napp.get('/b', async (req, res) => { throw new Error('B') })\n\napp.get('/c', (req, res) => {\n  setTimeout(() => { throw new Error('C') }, 100)\n  res.send('ok')\n})",
      "fontSize": 14,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25
    },
