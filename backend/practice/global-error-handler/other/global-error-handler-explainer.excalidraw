      "boundElements": [],
      "updated": 1795161628189,
      "link": null,
      "locked": false,
      "text": "Express wraps each handler call in try/catch\n→ next(err).  Works in Express 4 and 5. ✔",
      "fontSize": 17,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Express wraps each handler call in try/catch\n→ next(err).  Works in Express 4 and 5. ✔",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b0w"
    },
    {
      "id": "B-res",
      "type": "text",
      "x": 940,
      "y": 2493,
      "width": 474,
      "height": 64,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1141991851,
      "version": 2,
      "versionNonce": 127462513,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795161628189,
      "link": null,
      "locked": false,
      "text": "Express 5: sees the returned rejected promise\n→ next(err).  ✔\nExpress 4: nobody handles it, request hangs. ✖",
      "fontSize": 17,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Express 5: sees the returned rejected promise\n→ next(err).  ✔\nExpress 4: nobody handles it, request hangs. ✖",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b0x"
    },
