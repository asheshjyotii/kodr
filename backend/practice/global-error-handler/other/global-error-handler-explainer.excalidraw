      "link": null,
      "locked": false,
      "text": "UserModel.findOne(...) has no await, so 'user not found' never fires.\nSee Example B. Fix: const isExists = await UserModel.findOne({ email });",
      "fontSize": 15,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "UserModel.findOne(...) has no await, so 'user not found' never fires.\nSee Example B. Fix: const isExists = await UserModel.findOne({ email });",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b1S"
