      "updated": 1795161628189,
      "link": null,
      "locked": false,
      "text": "Q3  Why must errorMiddleware take exactly 4 parameters?",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Q3  Why must errorMiddleware take exactly 4 parameters?",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b1q"
    },
    {
      "id": "q2-b",
      "type": "text",
      "x": 78,
      "y": 4168,
      "width": 782,
      "height": 40,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1079478058,
      "version": 2,
      "versionNonce": 1002334449,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795161628189,
      "link": null,
      "locked": false,
      "text": "A: Express checks function.length === 4 to recognise an error handler. With 3, it\nis skipped during next(err).",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A: Express checks function.length === 4 to recognise an error handler. With 3, it\nis skipped during next(err).",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b1r"
    },
    {
      "id": "q3",
      "type": "rectangle",
      "x": 940,
      "y": 4117,
      "width": 860,
      "height": 109,
      "angle": 0,
