    },
    {
      "id": "exA-b",
      "type": "text",
      "x": 78,
      "y": 2945,
      "width": 724,
      "height": 132,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 562383365,
      "version": 2,
      "versionNonce": 1146792945,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795161628189,
      "link": null,
      "locked": false,
      "text": "1  express.json() parses the body → req.body = {}\n2  Router matches POST /login → loginController (wrapped by asyncHandler)\n3  if (!email || !password) → throw new AppError('all fields are required', 400)\n4  The async function turns that throw into a REJECTED promise\n5  asyncHandler: .catch(next) → next(err)\n6  Express skips normal middleware → errorMiddleware runs\n7  Response:  400  { success: false, message: 'all fields are required' }",
      "fontSize": 15,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1  express.json() parses the body → req.body = {}\n2  Router matches POST /login → loginController (wrapped by asyncHandler)\n3  if (!email || !password) → throw new AppError('all fields are required', 400)\n4  The async function turns that throw into a REJECTED promise\n5  asyncHandler: .catch(next) → next(err)\n6  Express skips normal middleware → errorMiddleware runs\n7  Response:  400  { success: false, message: 'all fields are required' }",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b15"
    },
