    {
      "id": "tl3-t",
      "type": "text",
      "x": 1399.5,
      "y": 1616.5,
      "width": 319,
      "height": 57,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
