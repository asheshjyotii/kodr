      "updated": 1795161628189,
      "link": null,
      "locked": false,
      "text": "Q1  a() calls b(), and b() throws with no catch anywhere. What runs after\nthe throw?",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Q1  a() calls b(), and b() throws with no catch anywhere. What runs after\nthe throw?",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b1k"
    },
    {
      "id": "q0-b",
      "type": "text",
      "x": 78,
      "y": 4045,
      "width": 772,
      "height": 40,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 2010844089,
      "version": 2,
      "versionNonce": 639554385,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795161628189,
      "link": null,
      "locked": false,
      "text": "A: Nothing in b(). a()'s remaining lines are skipped too. No catch → the process\ncrashes.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A: Nothing in b(). a()'s remaining lines are skipped too. No catch → the process\ncrashes.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b1l"
    },
    {
      "id": "q1",
      "type": "rectangle",
      "x": 940,
