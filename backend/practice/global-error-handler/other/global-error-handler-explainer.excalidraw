      "seed": 966026502,
      "version": 2,
      "versionNonce": 101529311,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795161628189,
      "link": null,
      "locked": false,
      "text": "function main() {\n  try {\n    register();                 // steps 1-3 happen inside\n    console.log('never runs');  // skipped by the throw\n  } catch (err) {\n    console.log(err.message);   // step 5: control lands here\n  }\n}",
      "fontSize": 16,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "function main() {\n  try {\n    register();                 // steps 1-3 happen inside\n    console.log('never runs');  // skipped by the throw\n  } catch (err) {\n    console.log(err.message);   // step 5: control lands here\n  }\n}",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "as"
    },
