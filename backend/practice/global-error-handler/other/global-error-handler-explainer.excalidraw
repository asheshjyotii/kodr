      "text": "Mental model:  throw (sync)  or  rejected promise (async)  →  next(err)  →  ONE error middleware  →  ONE JSON shape",
      "fontSize": 22,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Mental model:  throw (sync)  or  rejected promise (async)  →  next(err)  →  ONE error middleware  →  ONE JSON shape",
      "autoResize": true,
