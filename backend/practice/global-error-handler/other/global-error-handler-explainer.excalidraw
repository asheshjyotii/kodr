      "text": "C. Async handler wrapped by asyncHandler (this project)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "C. Async handler wrapped by asyncHandler (this project)",
