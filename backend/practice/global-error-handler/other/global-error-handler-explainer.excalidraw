      "updated": 1795161628189,
      "link": null,
      "locked": false,
      "text": "Q4  Why does an empty login body return 400, not 500?",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Q4  Why does an empty login body return 400, not 500?",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b1t"
    },
    {
      "id": "q3-b",
      "type": "text",
      "x": 958,
      "y": 4168,
      "width": 801,
      "height": 40,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 512619637,
      "version": 2,
      "versionNonce": 171896511,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795161628189,
      "link": null,
      "locked": false,
      "text": "A: AppError carries statusCode 400, and errorMiddleware uses err.statusCode. Errors\nwithout one default to 500.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A: AppError carries statusCode 400, and errorMiddleware uses err.statusCode. Errors\nwithout one default to 500.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b1u"
    },
