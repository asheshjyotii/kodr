      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3
      },
      "seed": 211313510,
      "version": 2,
      "versionNonce": 879598239,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795161628189,
      "link": null,
      "locked": false,
      "index": "b1s"
    },
    {
      "id": "q3-h",
      "type": "text",
      "x": 958,
      "y": 4135,
      "width": 577,
      "height": 23,
      "angle": 0,
      "strokeColor": "#1971c2",
