      "boundElements": [],
      "updated": 1795161628189,
      "link": null,
      "locked": false,
      "text": "Controllers say WHAT went wrong (AppError carries message + statusCode).\nThe one global middleware decides HOW it looks on the wire. Unknown errors fall back to 500.",
      "fontSize": 17,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Controllers say WHAT went wrong (AppError carries message + statusCode).\nThe one global middleware decides HOW it looks on the wire. Unknown errors fall back to 500.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b1O"
    },
