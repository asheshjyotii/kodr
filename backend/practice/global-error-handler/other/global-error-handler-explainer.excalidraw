      "updated": 1795161628189,
      "link": null,
      "locked": false,
      "text": "jwt.verify throws an error with no statusCode, so errorMiddleware uses 500\nand the message 'jwt malformed'. A 401 is the right answer.",
      "fontSize": 15,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "jwt.verify throws an error with no statusCode, so errorMiddleware uses 500\nand the message 'jwt malformed'. A 401 is the right answer.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b1e"
    },
