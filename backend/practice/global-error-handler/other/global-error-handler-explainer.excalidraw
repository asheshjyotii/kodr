    },
    {
      "id": "p5-b",
      "type": "text",
      "x": 958,
      "y": 3802,
      "width": 742,
      "height": 38,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
