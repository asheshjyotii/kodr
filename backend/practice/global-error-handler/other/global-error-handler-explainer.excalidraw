    {
      "id": "s1-bul",
      "type": "text",
      "x": 760,
      "y": 814,
      "width": 523,
      "height": 203,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1546139009,
      "version": 2,
      "versionNonce": 1969907391,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795161628189,
      "link": null,
      "locked": false,
      "text": "How the throw travels:\n1  main() calls register()\n2  register() calls validate()\n3  validate() executes throw\n4  throw skips the rest of each frame it leaves\n5  main()'s catch receives the error and runs.\n\nNo catch at all? Plain Node crashes the process.\nExpress catches sync throws for you (section 3).",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "How the throw travels:\n1  main() calls register()\n2  register() calls validate()\n3  validate() executes throw\n4  throw skips the rest of each frame it leaves\n5  main()'s catch receives the error and runs.\n\nNo catch at all? Plain Node crashes the process.\nExpress catches sync throws for you (section 3).",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "aq"
    },
    {
      "id": "s1-code",
