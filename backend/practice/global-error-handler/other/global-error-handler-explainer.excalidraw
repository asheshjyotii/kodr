    {
      "id": "p-note",
      "type": "text",
      "x": 60,
      "y": 2170,
      "width": 945,
      "height": 60,
      "angle": 0,
      "strokeColor": "#555555",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 906926689,
      "version": 2,
      "versionNonce": 1519976063,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795161628189,
      "link": null,
      "locked": false,
      "text": "Why exactly 4 parameters? Express recognises an error handler by function.length === 4.\nWith 3 parameters it is skipped during next(err), and the request gets Express's default HTML 500.\n/api/auth/me runs authMiddleware before its handler, so a throw there takes this same path.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Why exactly 4 parameters? Express recognises an error handler by function.length === 4.\nWith 3 parameters it is skipped during next(err), and the request gets Express's default HTML 500.\n/api/auth/me runs authMiddleware before its handler, so a throw there takes this same path.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b0o"
    },
    {
      "id": "s4",
      "type": "text",
