      "roundness": null,
      "seed": 1924625675,
      "version": 2,
      "versionNonce": 222282641,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795161628189,
      "link": null,
      "locked": false,
      "text": "If a response already started, errorMiddleware's res.status().json() throws again.\nFix: if (res.headersSent) return next(err);",
      "fontSize": 15,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "If a response already started, errorMiddleware's res.status().json() throws again.\nFix: if (res.headersSent) return next(err);",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b1h"
    },
